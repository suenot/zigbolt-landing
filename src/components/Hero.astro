---
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';

const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};

const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	fetchpriority: 'high' as const,
	width: 400,
	height: 400,
	alt: image?.alt || '',
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}
---

<div class="hero">
	<div class="hero-glow" aria-hidden="true"></div>
	<div class="hero-shape hero-shape-1" aria-hidden="true"></div>
	<div class="hero-shape hero-shape-2" aria-hidden="true"></div>
	{
		darkImage && (
			<div class="image-wrapper">
				<div class="image-glow" aria-hidden="true" />
				<Image
					src={darkImage}
					{...imageAttrs}
					class:list={{ 'light:sl-hidden': Boolean(lightImage) }}
				/>
			</div>
		)
	}
	{lightImage && <Image src={lightImage} {...imageAttrs} class="dark:sl-hidden" />}
	{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<p class="hero-badge"><span class="hero-badge-dot"></span>Pure Zig · Ultra-Low Latency</p>
			<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="sl-flex actions">
					{actions.map(
						({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
							<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</LinkButton>
						)
					)}
				</div>
			)
		}
	</div>
</div>

<style>
	@layer starlight.core {
		.hero {
			display: grid;
			align-items: center;
			gap: 1rem;
			padding-bottom: 1rem;
			position: relative;
		}

		/* Indigo glow wash behind the whole hero */
		.hero-glow {
			position: absolute;
			top: -6rem;
			left: 50%;
			transform: translateX(-50%);
			width: min(100%, 56rem);
			height: 28rem;
			background: radial-gradient(
					ellipse at 50% 30%,
					rgba(var(--mm-accent-rgb, 90, 76, 228), 0.16) 0%,
					transparent 65%
				);
			pointer-events: none;
			z-index: -1;
		}

		/* Floating capsule shapes (marketmaker.cc hero motif) */
		.hero-shape {
			display: none;
			position: absolute;
			border-radius: 9999px;
			border: 1px solid rgba(255, 255, 255, 0.08);
			background: linear-gradient(
				to right,
				rgba(var(--mm-accent-rgb, 90, 76, 228), 0.12),
				transparent
			);
			pointer-events: none;
			z-index: -1;
		}

		.hero-shape-1 {
			width: 34rem;
			height: 8rem;
			left: -8rem;
			top: -2rem;
			animation: shapeFloat 12s ease-in-out infinite;
		}

		.hero-shape-2 {
			width: 28rem;
			height: 6.5rem;
			right: -7rem;
			bottom: -3rem;
			animation: shapeFloat 12s ease-in-out infinite 2s;
		}

		@keyframes shapeFloat {
			0%,
			100% {
				transform: translateY(0);
			}
			50% {
				transform: translateY(15px);
			}
		}

		@keyframes badgePulse {
			0%,
			100% {
				opacity: 1;
			}
			50% {
				opacity: 0.4;
			}
		}

		/* Badge pill */
		.hero-badge {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.375rem 1rem;
			border-radius: 9999px;
			border: 1px solid rgba(var(--mm-accent-rgb, 90, 76, 228), 0.25);
			background: rgba(var(--mm-accent-rgb, 90, 76, 228), 0.07);
			color: var(--sl-color-accent-high);
			font-size: 0.72rem;
			font-weight: 700;
			letter-spacing: 0.2em;
			text-transform: uppercase;
			margin: 0;
			width: fit-content;
		}

		.hero-badge-dot {
			width: 0.5rem;
			height: 0.5rem;
			border-radius: 9999px;
			background: var(--sl-color-accent);
			animation: badgePulse 2s ease-in-out infinite;
		}

		.image-wrapper {
			position: relative;
			display: flex;
			justify-content: center;
			align-items: center;
			margin-inline: auto;
			width: 100%;
		}

		.image-glow {
			position: absolute;
			width: 16rem;
			height: 16rem;
			background: radial-gradient(
				circle,
				rgba(var(--mm-accent-rgb, 90, 76, 228), 0.3) 0%,
				transparent 70%
			);
			filter: blur(48px);
			z-index: -1;
		}

		.hero > img,
		.image-wrapper img,
		.hero > .hero-html {
			object-fit: contain;
			width: min(70%, 20rem);
			height: auto;
			margin-inline: auto;
		}

		.stack {
			flex-direction: column;
			gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
			text-align: center;
		}

		.copy {
			flex-direction: column;
			gap: 1.25rem;
			align-items: center;
		}

		.copy > * {
			max-width: 50ch;
		}

		h1 {
			font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
			line-height: var(--sl-line-height-headings);
			font-weight: 900;
			letter-spacing: -0.03em;
			color: var(--sl-color-white);
			background: linear-gradient(to bottom, #ffffff 30%, rgba(255, 255, 255, 0.68) 100%);
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
			text-shadow: none;
		}

		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
			color: var(--sl-color-gray-2);
			font-weight: 300;
			line-height: 1.7;
		}

		.actions {
			gap: 1rem 1.25rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		@media (prefers-reduced-motion: reduce) {
			.hero-shape,
			.hero-badge-dot {
				animation: none;
			}
		}

		@media (min-width: 50rem) {
			.hero {
				grid-template-columns: 4fr 7fr;
				gap: 5%;
				padding-block: clamp(2.5rem, calc(1rem + 10vmin), 8rem);
			}

			.hero-shape {
				display: block;
			}

			.image-wrapper,
			.hero > .hero-html {
				order: 1;
				width: min(100%, 25rem);
			}

			.stack {
				order: 2;
				text-align: start;
			}

			.copy {
				align-items: flex-start;
			}

			.actions {
				justify-content: flex-start;
				align-items: center; /* V-align buttons */
			}
		}
	}
</style>
